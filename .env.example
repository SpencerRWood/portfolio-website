VITE_API_BASE_URL=http://localhost:8000
# Public browser source settings for portfolio interaction analytics.
VITE_RUDDERSTACK_WRITE_KEY=replace-with-rudderstack-write-key
VITE_RUDDERSTACK_DATA_PLANE_URL=https://replace-with-rudderstack-data-plane
# Production container browser settings are supplied at runtime instead.
# RUDDERSTACK_WRITE_KEY=replace-with-rudderstack-write-key
# RUDDERSTACK_DATA_PLANE_URL=https://replace-with-rudderstack-data-plane

# Application runtime. Development uses a local Wood Data Platform connection;
# production receives DATABASE_URL from the deployment secret store.
WEBSITE_ENV=development
WOOD_DATA_PLATFORM_DATABASE_URL=postgresql://wood@localhost:5432/wood_data
# DATABASE_URL=postgresql://production-host/portfolio_website

# OpenProject implementation workbook (configure per created project)
OPENPROJECT_URL=https://openproject.example.com
# The shared story workflow reads OPENPROJECT_API_TOKEN from ~/.wood/runtime/openproject.env.
OPENPROJECT_PROJECT_ID=replace-with-openproject-project-identifier
OPENPROJECT_INITIATIVE_ID=replace-with-root-work-package-id
